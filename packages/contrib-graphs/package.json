{
  "name": "contrib-graphs",
  "version": "0.1.0",
  "description": "Contribution graph components for React: GitHub-style heatmaps in seven designs, with themes, dark mode, keyboard navigation and screen reader support.",
  "keywords": [
    "react",
    "contribution-graph",
    "heatmap",
    "github",
    "gitlab",
    "calendar",
    "portfolio",
    "svg"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown && node scripts/check-dist.mjs",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "jsdom": "^26.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vitest": "^4.1.12"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./data": {
      "import": "./dist/data.js",
      "require": "./dist/data.cjs"
    },
    "./package.json": "./package.json",
    "./styles.css": "./dist/styles.css"
  },
  "bin": {
    "contrib-graphs": "./dist/bin.js"
  }
}
