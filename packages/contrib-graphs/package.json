{
  "name": "contrib-graphs",
  "version": "0.1.2",
  "description": "Seven React components that draw your GitHub, GitLab or any other activity as a calendar heatmap. Install from npm or copy the source with the shadcn CLI.",
  "keywords": [
    "react",
    "contribution-graph",
    "heatmap",
    "github",
    "gitlab",
    "calendar",
    "portfolio",
    "svg"
  ],
  "license": "MIT",
  "author": "Francis Miguel Castillo Cruz (https://github.com/ingfranciscastillo)",
  "homepage": "https://ingfranciscastillo.github.io/contrib-graphs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ingfranciscastillo/contrib-graphs.git",
    "directory": "packages/contrib-graphs"
  },
  "bugs": {
    "url": "https://github.com/ingfranciscastillo/contrib-graphs/issues"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown && node scripts/check-dist.mjs",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "jsdom": "^26.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vitest": "^4.1.12"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./data": {
      "import": "./dist/data.js",
      "require": "./dist/data.cjs"
    },
    "./package.json": "./package.json",
    "./styles.css": "./dist/styles.css"
  }
}
