{
  "name": "contrib-graphs-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "npm run dev -w site",
    "build": "npm run build -w contrib-graphs && npm run build -w site",
    "build:package": "npm run build -w contrib-graphs",
    "data": "npm run data -w site",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run typecheck && npm test --workspaces --if-present",
    "api": "npm run api -w site",
    "images": "npm run build:package && npm run images -w site",
    "og": "npm run build:package && npm run og -w site"
  }
}
