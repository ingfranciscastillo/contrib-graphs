# Copia este archivo como .env.local (no se sube a git) y pega tu token.
#
# Token clásico con el permiso read:user para incluir contribuciones privadas:
# https://github.com/settings/tokens/new?scopes=read:user&description=contribution-graphs
# Sin token, `npm run data` usa la página pública de contribuciones.
GITHUB_TOKEN=
